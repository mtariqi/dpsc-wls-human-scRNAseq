library(Seurat)

obj <- readRDS(
  "data/processed/GSE164157_raw.rds"
)

obj[["percent.mt"]] <-
  PercentageFeatureSet(
    obj,
    pattern = "^MT-"
  )

VlnPlot(
  obj,
  features = c(
    "nFeature_RNA",
    "nCount_RNA",
    "percent.mt"
  ),
  ncol = 3
)

ggsave(
  "results/figures/QC_violin.png",
  width = 12,
  height = 5
)

obj <- subset(
  obj,
  subset =
    nFeature_RNA > 200 &
    nCount_RNA > 500 &
    percent.mt < 20
)

saveRDS(
  obj,
  "data/processed/GSE164157_qc.rds"
)

print(obj)
